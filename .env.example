# Application
APP_NAME=DataPilot AI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# LLM
LLM_PROVIDER=local
LLM_MODEL=Qwen3.5-4B
LLM_BASE_URL=http://localhost:8080

# Database
DATABASE_URL=sqlite:///./datapilot.db

# Logging
LOG_LEVEL=INFO

# Dataset upload and processing limits
DATASET_MAX_UPLOAD_SIZE_BYTES=52428800
DATASET_STORAGE_MAX_BYTES=1073741824
DATASET_PREVIEW_MAX_ROWS=100
DATASET_MAX_ROWS=1000000
DATASET_MAX_COLUMNS=2000
DATASET_MAX_CELLS=10000000
DATASET_MAX_DATAFRAME_MEMORY_BYTES=536870912
DATASET_MAX_PROCESSING_SECONDS=30
DATASET_MAX_XLSX_UNCOMPRESSED_BYTES=268435456
DATASET_MAX_PARQUET_UNCOMPRESSED_BYTES=536870912
DATASET_MAX_ARCHIVE_COMPRESSION_RATIO=100
DATASET_MAX_JSON_NESTING_DEPTH=100
